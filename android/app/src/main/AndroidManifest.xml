<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Position du délégué à l'appel et au cahier de texte, quand l'établissement l'exige. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Ajoutées par open_filex, jamais demandées ici : l'application n'ouvre que
         des fichiers de son dossier temporaire et choisit les pièces par le
         sélecteur du système. Google Play refuse ces accès sans fonction qui les exige. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>

    <application
        android:label="YSEM"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Liens d'application (App Links) : une page du portail web touchée
                 hors de l'application s'ouvre dans l'application. Android vérifie
                 que le site la reconnaît (/.well-known/assetlinks.json). L'hôte
                 suit API_BASE_URL (build.gradle.kts) ; les chemins sont ceux de
                 lib/features/commun/liens/liens_entrants.dart, et eux seuls
                 (garde : test/liens_entrants_test.dart). -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true"/>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="${hoteLiens}"/>
                <data android:pathPrefix="/portail-etudiant/tableau-de-bord/"/>
                <data android:pathPrefix="/portail-etudiant/ma-scolarite/"/>
                <data android:pathPrefix="/portail-etudiant/planning-des-examens/"/>
                <data android:pathPrefix="/portail-etudiant/mes-notes/"/>
                <data android:pathPrefix="/portail-etudiant/mes-devoirs/"/>
                <data android:pathPrefix="/portail-etudiant/ma-promotion/"/>
                <data android:pathPrefix="/portail-etudiant/mes-supports-de-cours/"/>
                <data android:pathPrefix="/portail-etudiant/archives/"/>
                <data android:pathPrefix="/portail-etudiant/bibliotheque/"/>
                <data android:pathPrefix="/portail-etudiant/ma-reinscription/"/>
                <data android:pathPrefix="/portail-etudiant/mes-documents/"/>
                <data android:pathPrefix="/portail-etudiant/ma-situation-financiere/"/>
                <data android:pathPrefix="/portail-etudiant/ma-discipline/"/>
                <data android:pathPrefix="/portail-etudiant/mes-permissions/"/>
                <data android:pathPrefix="/portail-etudiant/ma-delegation/"/>
                <data android:pathPrefix="/portail-etudiant/evaluations/"/>
                <data android:pathPrefix="/portail-etudiant/association/"/>
                <data android:pathPrefix="/portail-etudiant/boite-a-suggestions/"/>
                <data android:pathPrefix="/portail-etudiant/mon-profil/"/>
                <data android:pathPrefix="/chat-cours/etudiant/"/>
                <data android:pathPrefix="/messagerie/mes-messages/"/>
                <data android:pathPrefix="/enseignants/tableau-de-bord/"/>
                <data android:pathPrefix="/enseignants/mon-emploi-du-temps/"/>
                <data android:pathPrefix="/enseignants/mes-disponibilites/"/>
                <data android:pathPrefix="/enseignants/mes-examens/"/>
                <data android:pathPrefix="/enseignants/mes-rattrapages/"/>
                <data android:pathPrefix="/enseignants/mes-classes/"/>
                <data android:pathPrefix="/enseignants/mes-devoirs/"/>
                <data android:pathPrefix="/enseignants/fiches-a-signer/"/>
                <data android:pathPrefix="/enseignants/mes-enseignements/"/>
                <data android:pathPrefix="/enseignants/mes-documents-de-cours/"/>
                <data android:pathPrefix="/enseignants/mes-plans-de-cours/"/>
                <data android:pathPrefix="/enseignants/mes-epreuves/"/>
                <data android:pathPrefix="/enseignants/mes-feuilles-de-notes/"/>
                <data android:pathPrefix="/enseignants/ma-ponctualite/"/>
                <data android:pathPrefix="/enseignants/mes-vacations/"/>
                <data android:pathPrefix="/enseignants/mon-dossier/"/>
                <data android:pathPrefix="/chat-cours/enseignant/"/>
            </intent-filter>
        </activity>
        <!-- Inscription par identifiant d'installation : FCM a déprécié les jetons
             d'enregistrement, et le serveur écrit à ce `fid`. -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <!-- Présentation des notifications push. Le canal est créé par
             MainActivity ; son identifiant est celui de notifications/push.py. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ysem_notifications" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
